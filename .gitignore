# Python bytecode, virtual environments, and build outputs.
__pycache__/
*.py[cod]
*$py.class
.venv/
.venv-crosssim/
.venv-autolens/
.python-crosssim/
.cache-crosssim/
venv/
ENV/
env/
*.egg-info/
build/
dist/

# Test/tool caches and historical temporary roots. New tests use OS temporary storage.
.pytest_cache/
.pytest-*/
results/test-tmp/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Local datasets and generated image products. Manifests and source tables are
# intentionally left trackable as compact provenance records.
castles/
normalized/
data/simulations/
data/raw/external/
data/external_reference_research/
data/releases/*/products/
data/releases/*/previews/
data/derived/actual/*/products/

# Human review previews are regenerated from versioned inputs. Their indexes
# and written reports remain eligible for version control.
results/previews/actual/*/
results/previews/simulated/*/

# Model binaries are reproducible artifacts; retain their configs, hashes,
# metrics, predictions, and reports instead.
*.pt
*.pth
*.ckpt

# Notebook checkpoint folders and local editor/operating-system files.
.ipynb_checkpoints/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
tempCodeRunnerFile.py

# Transient command output.
*.log

# Private project notes, local secrets, and non-shareable working material.
private/
**/private/
*.private
*.private.*
*.secret
*.secret.*
.env
.env.*
!.env.example

# Local FITS header scratch files.
q256_header.txt

# Reviewer boundary: only the curated source under
# submission/aaai27/reviewer_bundle/ is intended for workshop sharing. Raw
# data, generated results, local author-kit files, and internal reports remain
# private even when they are present in the working tree.
# Anchor repository-local data and results rules.  The unanchored forms also
# ignored active source modules under src/data/ and src/results/.
# Ignore products by default, but expose compact evidence for explicit review.
# These exceptions do not make data/results part of the reviewer upload.
/results/*
!/results/README.md
!/results/ml/
!/results/reports/
/results/ml/**
/results/reports/**
!/results/ml/**/
!/results/reports/**/
!/results/ml/**/*.md
!/results/ml/**/*.json
!/results/ml/**/*.csv
!/results/ml/**/*.sha256
!/results/reports/**/*.md
!/results/reports/**/*.json
!/results/reports/**/*.csv
!/results/reports/**/*.sha256
/data/*
!/data/README.md
!/data/labels/
!/data/manifests/
!/data/releases/
/data/labels/**
/data/manifests/**
/data/releases/**
!/data/labels/**/
!/data/manifests/**/
!/data/releases/**/
!/data/labels/**/*.csv
!/data/labels/**/*.md
!/data/manifests/**/*.csv
!/data/manifests/**/*.json
!/data/manifests/**/*.md
!/data/manifests/**/*.sha256
!/data/releases/**/*.csv
!/data/releases/**/*.json
!/data/releases/**/*.md
!/data/releases/**/*.sha256
# Keep arrays and previews excluded even when they contain text sidecars.
/data/releases/*/products/
/data/releases/*/previews/
**/*.private.*
docs/private/
submission/aaai27/private/
/submission/aaai27/ai2ase_overleaf_project/
/submission/aaai27/ai2ase_overleaf_project.zip

# Local archive of generated/editor artifacts.  Historical source notes and
# scripts under archive/ are intentionally trackable; this subtree is not.
/archive/scratch/
/archive/private/

# Privacy exclusions take precedence over compact-evidence exceptions.
private/
**/private/
*.private
*.private.*
*.secret
*.secret.*
.env
.env.*
!.env.example
